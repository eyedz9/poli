# ─── Postgres (Docker-local) ───────────────────────────────────────────
POSTGRES_USER=polireports
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32
POSTGRES_DB=polireports
# DATABASE_URL is assembled by docker-compose — do not set manually

# ─── pgAdmin ──────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@polireports.local
PGADMIN_PASSWORD=change-me-generate-with-openssl-rand-hex-16

# ─── Anthropic (Claude API) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Data Sources ──────────────────────────────────────────────────────
# Google Trends (requires Google Cloud project)
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-service-account.json

# GDELT (BigQuery — same GCP project)
GDELT_BIGQUERY_DATASET=gdelt-bq.gdeltv2

# YouTube Data API v3
YOUTUBE_API_KEY=AIza...

# Apify (Reddit scraper)
APIFY_API_TOKEN=apify_api_...

# Bright Data (primary scraping infra)
BRIGHTDATA_USERNAME=your-username
BRIGHTDATA_PASSWORD=your-password
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=22225

# Bluesky AT Protocol
BLUESKY_SERVICE_URL=https://bsky.social
# No auth needed for public firehose — but set if posting
# BLUESKY_IDENTIFIER=your.handle.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── Redis ────────────────────────────────────────────────────────────
# REDIS_URL is set by docker-compose using REDIS_PASSWORD — do not set here
REDIS_PASSWORD=change-me-generate-with-openssl-rand-hex-32

# ─── n8n ──────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=change-me-generate-with-openssl-rand-hex-16

# ─── API ──────────────────────────────────────────────────────────────
API_PORT=3000
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
API_KEY_SALT=change-me-generate-with-openssl-rand-hex-32
# Token n8n uses to call /api/issues/trigger-ingest (internal only)
INTERNAL_TRIGGER_TOKEN=change-me-generate-with-openssl-rand-hex-32
# Comma-separated allowed CORS origins for dashboard
DASHBOARD_ORIGINS=http://localhost:5173

# ─── Optional ─────────────────────────────────────────────────────────
# NewsWhip (post-MVP)
# NEWSWHIP_API_KEY=

# Voyage AI embeddings (alternative to Claude embeddings)
# VOYAGE_API_KEY=

# ─── Env ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
TZ=America/New_York
