# ─── Supabase (cloud) ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── Anthropic (Claude API) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Data Sources ──────────────────────────────────────────────────────
# Google Trends (requires Google Cloud project)
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-service-account.json

# GDELT (BigQuery — same GCP project)
GDELT_BIGQUERY_DATASET=gdelt-bq.gdeltv2

# YouTube Data API v3
YOUTUBE_API_KEY=AIza...

# Apify (Reddit scraper)
APIFY_API_TOKEN=apify_api_...

# Bright Data (primary scraping infra)
BRIGHTDATA_USERNAME=your-username
BRIGHTDATA_PASSWORD=your-password
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=22225

# Bluesky AT Protocol
BLUESKY_SERVICE_URL=https://bsky.social
# No auth needed for public firehose — but set if posting
# BLUESKY_IDENTIFIER=your.handle.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── n8n ──────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=change-me-in-production

# ─── API ──────────────────────────────────────────────────────────────
API_PORT=3000
JWT_SECRET=change-me-in-production-min-32-chars
API_KEY_SALT=change-me-in-production-min-32-chars

# ─── Optional ─────────────────────────────────────────────────────────
# NewsWhip (post-MVP)
# NEWSWHIP_API_KEY=

# Voyage AI embeddings (alternative to Claude embeddings)
# VOYAGE_API_KEY=

# ─── Env ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
TZ=America/New_York
